FROM golang:1.27.1-alpine AS builder

WORKDIR /app

RUN go install github.com/air-verse/air@latest

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# The main package is in src/; air rebuilds it on every change.
ENTRYPOINT ["air", "--build.cmd", "go build -o ./tmp/main ./src", "--build.entrypoint", "./tmp/main"]
