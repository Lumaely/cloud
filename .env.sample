# Full Postgres URL; when set, it replaces the DB_* values below.
DATABASE_URL=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
DB_HOST=

MINIO_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=
MINIO_REGION=
MINIO_USE_SSL=

# cloud or self-hosted
SERVER_MODE=
# Long random string; keeps fake login salts stable across restarts.
SERVER_SECRET=
# Defaults to 5 GiB in cloud mode, unlimited in self-hosted mode.
STORAGE_QUOTA_BYTES=
MAIL_DRIVER=log
SCW_SECRET_KEY=
SCW_PROJECT_ID=
SCW_REGION=
# Comma-separated proxy IPs/CIDRs; needed for per-client rate limits behind a reverse proxy.
TRUSTED_PROXIES=
# Folder of goose .sql migrations to use instead of the ones built into the binary (tests, local runs).
MIGRATIONS_DIR=
